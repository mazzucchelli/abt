{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abt.dev/schema/merge-policy.schema.json",
  "title": "abt merge policy",
  "type": "object",
  "required": ["version", "gates", "enforcement", "risk_cap", "mode", "land_tree_hash"],
  "properties": {
    "version": { "const": 1 },
    "gates": {
      "type": "object",
      "required": ["required_checks", "approvals"],
      "properties": {
        "required_checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "approvals": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "enforcement": { "enum": ["server", "self"] },
    "compensating_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["runner-sole-merger", "head-sha-recheck"] }
    },
    "risk_cap": { "enum": ["low", "none"] },
    "mode": { "enum": ["merge", "pr-only"] },
    "evidence": {
      "type": "object",
      "properties": { "self_certification": { "const": false } },
      "additionalProperties": false
    },
    "risk_map": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["glob", "tier", "reason"],
            "properties": {
              "glob": { "type": "string", "minLength": 1 },
              "tier": { "enum": ["low", "medium", "high"] },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "max_lines": { "type": "integer", "minimum": 1 },
        "max_files": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "object",
      "required": ["default_branch"],
      "properties": {
        "default_branch": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "land_tree_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false,
  "if": { "properties": { "enforcement": { "const": "self" } }, "required": ["enforcement"] },
  "then": {
    "required": ["compensating_controls"],
    "properties": { "compensating_controls": { "allOf": [{ "contains": { "const": "runner-sole-merger" } }, { "contains": { "const": "head-sha-recheck" } }] } }
  }
}
