{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abt.dev/schema/decision-log.schema.json",
  "title": "abt decision record",
  "type": "object",
  "required": ["id", "timestamp", "ticket", "run", "node", "kind", "decision", "why", "evidence", "result", "payload"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "ticket": { "type": "string", "minLength": 1 },
    "run": { "type": "string", "minLength": 1 },
    "node": { "type": ["string", "null"], "minLength": 1 },
    "kind": {
      "enum": [
        "node-outcome",
        "risk-assessment",
        "routing",
        "ask-point",
        "override",
        "retype",
        "escalation",
        "merge",
        "pivot",
        "blocked",
        "note"
      ]
    },
    "decision": { "type": "string", "minLength": 1 },
    "why": { "type": "string" },
    "evidence": { "type": ["string", "null"], "minLength": 1 },
    "result": { "enum": ["ok", "fail", "running", "skipped", "inconclusive", "open", "error"] },
    "supersedes": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "node-outcome" } } },
      "then": {
        "required": ["node"],
        "properties": {
          "node": { "type": "string" },
          "payload": {
            "required": ["nodeKind"],
            "properties": {
              "nodeKind": { "enum": ["seq", "fallback", "all", "any", "not", "retry", "timeout", "check", "judge", "script", "action", "agent"] },
              "worker": { "type": "string", "minLength": 1 },
              "headSha": { "type": "string", "minLength": 1 },
              "usageLimit": {
                "type": "object",
                "properties": {
                  "rateLimitType": { "type": "string", "minLength": 1 },
                  "resetsAt": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "risk-assessment" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["tier", "reasons"],
            "properties": {
              "tier": { "enum": ["low", "medium", "high"] },
              "floor": { "enum": ["low", "medium", "high"] },
              "moment": { "enum": ["intake", "ask-point", "landing"] },
              "judged": { "enum": ["low", "medium", "high"] },
              "failure": { "type": "string", "minLength": 1 },
              "summarised": { "type": "boolean" },
              "askAgain": { "type": "boolean" },
              "workType": { "enum": ["implement", "research", "spike", "bootstrap"] },
              "reasons": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "routing" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["grade", "model", "effort", "min_model_from_risk"],
            "properties": {
              "grade": { "enum": ["simple", "standard", "hard"] },
              "model": { "type": "string", "minLength": 1 },
              "effort": { "type": "string", "minLength": 1 },
              "min_model_from_risk": { "type": "string", "minLength": 1 },
              "base": { "enum": ["simple", "standard", "hard"] },
              "judged": { "enum": ["simple", "standard", "hard"] },
              "steps": { "type": "integer", "minimum": 0 },
              "source": { "enum": ["rules", "judge", "risk", "step-up", "override"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "ask-point" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["question", "recommended", "reversible", "handling"],
            "properties": {
              "question": { "type": "string", "minLength": 1 },
              "recommended": { "type": "string", "minLength": 1 },
              "reversible": { "type": "boolean" },
              "handling": { "enum": ["decided", "escalated"] },
              "retype": { "enum": ["implement", "research", "spike", "bootstrap"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "override" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["target", "by"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "by": { "type": "string", "minLength": 1 },
              "value": {},
              "comment": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "retype" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["by", "from", "to"],
            "properties": {
              "by": { "type": "string", "minLength": 1 },
              "from": { "enum": ["implement", "research", "spike", "bootstrap"] },
              "to": { "enum": ["implement", "research", "spike", "bootstrap"] },
              "branch": { "type": "string", "minLength": 1 },
              "pr": { "type": "string", "minLength": 1 },
              "tier": { "enum": ["low", "medium", "high"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "note" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["by", "text"],
            "properties": {
              "by": { "type": "string", "minLength": 1 },
              "text": { "type": "string" },
              "comment": { "type": "string", "minLength": 1 },
              "reminder": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "escalation" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["reason", "needs"],
            "properties": {
              "reason": { "type": "string", "minLength": 1 },
              "needs": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 1 },
              "recommended": { "type": "string", "minLength": 1 },
              "reversible": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "merge" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["pr", "sha", "policy_hash", "tree_hash"],
            "properties": {
              "pr": { "type": "string", "minLength": 1 },
              "sha": { "type": "string", "minLength": 1 },
              "policy_hash": { "type": "string", "minLength": 1 },
              "tree_hash": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "pivot" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["from", "to", "trigger"],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "trigger": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "blocked" } } },
      "then": {
        "properties": {
          "payload": {
            "required": ["by"],
            "properties": {
              "by": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
